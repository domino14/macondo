FROM golang:alpine AS build-env

RUN mkdir /opt/program
WORKDIR /opt/program

RUN apk update
RUN apk add build-base ca-certificates git

COPY go.mod .
COPY go.sum .
RUN go mod download

COPY . .

WORKDIR /opt/program/cmd/bot
RUN go build

# Build minimal image:
FROM alpine
COPY --from=build-env /opt/program/cmd/bot/bot /opt/bot

WORKDIR /opt
# Exec form, so the bot itself gets SIGTERM and drains (see bot.Main).
CMD ["./bot"]
